# =============================================================================
# Docker
# COMPOSE_PROJECT_NAME drives container/volume names and Traefik hostnames:
# my-project → https://my-project.dev.localhost
# =============================================================================
COMPOSE_PROJECT_NAME=my-project

# Drupal project root (composer.json), relative to this file: "." or e.g. "site".
APP_DIR=.

# Optional services: "tools" starts Adminer. Leave empty to disable.
COMPOSE_PROFILES=tools

# Host user IDs (`id -u` / `id -g`); `make init` fills them in.
USER_ID=1000
GROUP_ID=1000

# docker-base images: <major>.<minor>, set by `make docker-update`.
# Patch releases and weekly security rebuilds arrive with `make pull`.
DOCKER_BASE_VERSION=0.0

# Runtime versions (apply with `make pull`)
PHP_VERSION=8.4
NODE_VERSION=22
MARIADB_VERSION=11.8

# Xdebug: "off" for speed, "debug" to enable (`make xdebug-on`).
XDEBUG_MODE=off

# Host SSH agent socket forwarded to the php container (Composer private repos,
# Deployer). Docker Desktop: /run/host-services/ssh-auth.sock — Linux: REQUIRED,
# set it to your $SSH_AUTH_SOCK path (`make check` verifies it).
SSH_AUTH_SOCK_HOST=/run/host-services/ssh-auth.sock

# Host port to reach MariaDB from a local client (0 = random, see `make db-port`).
DB_HOST_PORT=0

# =============================================================================
# Database
# =============================================================================
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=drupal
# Must match the table prefix of the dump you import (empty = none).
MYSQL_PREFIX=

# =============================================================================
# Redis — set to 1 only once the redis contrib module is enabled.
# =============================================================================
REDIS_ENABLED=0
REDIS_PASSWORD=

# =============================================================================
# Drupal — HASH_SALT is generated by `make init`.
# =============================================================================
HASH_SALT=
TRUSTED_HOST_PATTERNS=^.+\.dev\.localhost$
# Relative to the docroot (web/).
DRUPAL_PRIVATE_PATH=../storage/private/default
DRUPAL_TMP_PATH=../storage/tmp/default
DRUPAL_CONFIG_SYNC=../config/sync

# =============================================================================
# Mail (Mailpit catches everything in dev)
# =============================================================================
# symfony_mailer contrib only: id of a transport config entity pointing to
# mailpit:1025 (SMTP, no auth). Leave empty when the module is not used.
SMTP_TRANSPORT=mailpit

# =============================================================================
# Vite dev server (node service)
# =============================================================================
VITE_SERVER_PORT=3014
VITE_SERVER_HOST=localhost
